-- ============================================
-- MM2 AUTO JOINER v2 - FIXED SERVER HOP
-- ============================================

local botToken = "MTUzNTU5MDk1MTYwMTMxMTc5NA.Gf-OKg.uTgnBA3VA6Iva8tS3JdWt-XYuMRu8W5rqtsHNM"
local channelId = "1501264872304808139"
local logId = "1530368045216698428"
local tradesBeforeNext = 1

-- ============================================
-- FIXED SERVER HOP LOGIC
-- ============================================

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

local function GetCurrentJobId()
    return game.JobId
end

local function GetDiscordMessages()
    local url = "https://discord.com/api/v9/channels/" .. channelId .. "/messages?limit=10"
    local headers = {
        ["Authorization"] = botToken,
        ["Content-Type"] = "application/json"
    }
    local success, response = pcall(function()
        return request({
            Url = url,
            Method = "GET",
            Headers = headers
        })
    end)
    if success and response and response.Success then
        local data = HttpService:JSONDecode(response.Body)
        return data
    end
    return {}
end

local function SendLogMessage(message)
    local url = "https://discord.com/api/v9/channels/" .. logId .. "/messages"
    local headers = {
        ["Authorization"] = botToken,
        ["Content-Type"] = "application/json"
    }
    local payload = {
        content = message
    }
    pcall(function()
        request({
            Url = url,
            Method = "POST",
            Headers = headers,
            Body = HttpService:JSONEncode(payload)
        })
    end)
end

local function ExtractJobIdFromMessage(message)
    if not message or not message.content then return nil end
    local content = message.content
    -- Look for job ID pattern (alphanumeric with hyphens)
    local jobId = string.match(content, "([%w%-]+)")
    if jobId and #jobId > 10 then
        return jobId
    end
    return nil
end

local function GetLatestServerJobId()
    local messages = GetDiscordMessages()
    if not messages or #messages == 0 then
        SendLogMessage("[ERROR] No messages found in channel.")
        return nil
    end
    for _, msg in ipairs(messages) do
        local jobId = ExtractJobIdFromMessage(msg)
        if jobId then
            return jobId
        end
    end
    SendLogMessage("[ERROR] No valid Job ID found in recent messages.")
    return nil
end

local function IsTargetServer(jobId)
    if not jobId then return false end
    local current = GetCurrentJobId()
    return current ~= jobId
end

local function HopToServer(jobId)
    if not jobId then
        SendLogMessage("[ERROR] Invalid Job ID provided.")
        return false
    end
    if not IsTargetServer(jobId) then
        SendLogMessage("[INFO] Already on target server: " .. jobId)
        return false
    end
    SendLogMessage("[HOP] Teleporting to server: " .. jobId)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, Players.LocalPlayer)
    end)
    return true
end

local function WaitForPlayerLoad()
    local player = Players.LocalPlayer
    if not player then return false end
    local attempts = 0
    while attempts < 30 do
        attempts = attempts + 1
        task.wait(1)
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            return true
        end
    end
    return false
end

local function GetTradeCount()
    -- Count trades performed in current session
    local count = 0
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Trade = ReplicatedStorage:FindFirstChild("Trade")
    if Trade then
        local TradeHistory = Trade:FindFirstChild("TradeHistory")
        if TradeHistory then
            local data = TradeHistory:InvokeServer()
            if type(data) == "table" then
                count = #data
            end
        end
    end
    return count
end

local function ShouldHop()
    local tradeCount = GetTradeCount()
    if tradeCount >= tradesBeforeNext then
        return true
    end
    return false
end

-- ============================================
-- MAIN LOOP WITH SERVER HOP
-- ============================================

local function MainLoop()
    SendLogMessage("[START] MM2 Auto Joiner v2 started.")
    
    while true do
        -- Wait for player to be fully loaded
        if not WaitForPlayerLoad() then
            SendLogMessage("[WARN] Player not loaded, retrying...")
            task.wait(5)
            continue
        end
        
        -- Check if we should hop
        if ShouldHop() then
            SendLogMessage("[INFO] Trade limit reached, finding new server...")
            
            local targetJobId = GetLatestServerJobId()
            if targetJobId then
                SendLogMessage("[INFO] Found target server: " .. targetJobId)
                HopToServer(targetJobId)
                -- Wait for teleport to complete
                task.wait(10)
            else
                SendLogMessage("[ERROR] Could not find server to hop to.")
                task.wait(30)
            end
        else
            -- Wait before checking again
            task.wait(5)
        end
    end
end

-- ============================================
-- LOAD THE JOINER SCRIPT WITH FIX
-- ============================================

-- Override the default behavior of the joiner script
local originalJoiner = loadstring(game:HttpGet('https://raw.githubusercontent.com/aaalmaz0/mm2/refs/heads/main/joiner.lua'))()

-- Inject our fixed server hop logic
if originalJoiner then
    -- Replace the hop function if it exists
    if originalJoiner.HopToServer then
        originalJoiner.HopToServer = HopToServer
    end
    if originalJoiner.GetLatestServerJobId then
        originalJoiner.GetLatestServerJobId = GetLatestServerJobId
    end
    SendLogMessage("[INFO] Joiner script loaded with fixes.")
else
    SendLogMessage("[WARN] Joiner script failed to load, using fallback.")
end

-- Start the main loop
task.spawn(MainLoop)

-- ============================================
-- EXTRA: Force server hop on command
-- ============================================

local function ForceHop()
    local targetJobId = GetLatestServerJobId()
    if targetJobId then
        HopToServer(targetJobId)
        return true
    end
    return false
end

_G.ForceHop = ForceHop

SendLogMessage("[READY] Auto Joiner is running. Use _G.ForceHop() to manually hop.")

-- ============================================
-- MONITOR FOR SERVER CHANGE
-- ============================================

local lastJobId = GetCurrentJobId()
game:GetService("RunService").Heartbeat:Connect(function()
    local current = GetCurrentJobId()
    if current ~= lastJobId then
        SendLogMessage("[INFO] Server changed to: " .. current)
        lastJobId = current
        -- Reset trade counter logic here if needed
    end
end)

return {
    HopToServer = HopToServer,
    GetLatestServerJobId = GetLatestServerJobId,
    ForceHop = ForceHop,
    GetTradeCount = GetTradeCount
}
