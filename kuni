-- Blinking dot animation
task.spawn(function()
    while true do
        if isConnected then
            StatusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            StatusLabel.Text = "CONNECTED"
            StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            task.wait(0.5)
            StatusDot.BackgroundColor3 = Color3.fromRGB(0, 200, 80)
            task.wait(0.5)
        else
            StatusDot.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
            StatusLabel.Text = "DISCONNECTED"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
            task.wait(0.5)
            StatusDot.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            task.wait(0.5)
        end
    end
end)

-- Uptime counter
task.spawn(function()
    while true do
        local elapsed = tick() - startTime
        local hours = string.format("%02d", math.floor(elapsed / 3600))
        local minutes = string.format("%02d", math.floor((elapsed % 3600) / 60))
        local seconds = string.format("%02d", math.floor(elapsed % 60))
        UptimeLabel.Text = "UPTIME  : " .. hours .. ":" .. minutes .. ":" .. seconds
        task.wait(1)
    end
end)

