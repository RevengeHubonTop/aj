    end
end)

-- Monitor network connection status
task.spawn(function()
    while true do
        task.wait(2)
        local success, conn = pcall(function()
            return game:GetService("NetworkClient"):GetConnectionStatus()
        end)
        if success then
            if conn == Enum.ConnectionStatus.Connected then
                isConnected = true
            else
                isConnected = false
            end
        end
    end
end)

