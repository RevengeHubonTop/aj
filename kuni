-- ===== AUTOJOINER CODE =====
-- Configuration
local targetUsers = {"x4nlm", "usjejj", "admstocked1"} -- Users to join
local minPlayers = 2 -- Minimum players to stay
local maxPlayers = 12 -- Max players per server
local checkInterval = 5 -- Seconds between checks
local hopCooldown = 10 -- Seconds before hopping again

local isHopping = false
local currentTarget = nil
local lastHopTime = 0
local joinCount = 0
local tradeCount = 0

-- Get available servers
local function GetServers()
    local servers = {}
    local success, response = pcall(function()
        return request({
            Url = "https://games.roblox.com/v1/games/142823291/servers/Public?limit=100",
            Method = "GET",
            Headers = {
                ["User-Agent"] = "Mozilla/5.0"
            }
        })
    end)
    if success and response and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end
        end
    end
    return servers
end

-- Hop to a new server
local function HopToServer()
    if isHopping then return end
    if tick() - lastHopTime < hopCooldown then return end
    
    isHopping = true
    _G.KUNI_UI.SetConnecting()
    
    local servers = GetServers()
    if #servers > 0 then
        local target = servers[math.random(1, #servers)]
        joinCount = joinCount + 1
        _G.KUNI_UI.SetQueue(joinCount)
        print("[AutoJoiner] Hopping to: " .. target)
        lastHopTime = tick()
        TeleportService:TeleportToPlaceInstance(142823291, target, LP)
    else
        _G.KUNI_UI.SetDisconnected()
        print("[AutoJoiner] No servers available")
        isHopping = false
        task.wait(3)
        HopToServer()
    end
end

-- Check if target user is in server
local function IsTargetInServer()
    for _, name in ipairs(targetUsers) do
        if Players:FindFirstChild(name) then
            currentTarget = name
            return true
        end
    end
    return false
end

-- Main loop
task.spawn(function()
    while true do
        task.wait(checkInterval)
        
        if isHopping then continue end
        
        local playerCount = #Players:GetPlayers()
        
        if playerCount <= 1 then
            _G.KUNI_UI.SetDisconnected()
            print("[AutoJoiner] Alone, hopping...")
            HopToServer()
        elseif IsTargetInServer() then
            _G.KUNI_UI.SetConnected()
            print("[AutoJoiner] Target found: " .. currentTarget)
            -- Stay in server with target
        elseif playerCount < minPlayers then
            _G.KUNI_UI.SetDisconnected()
            print("[AutoJoiner] Low players, hopping...")
            HopToServer()
        else
            _G.KUNI_UI.SetConnected()
        end
    end
end)

-- When a target joins, stay
Players.PlayerAdded:Connect(function(player)
    for _, name in ipairs(targetUsers) do
        if player.Name == name then
            currentTarget = name
            _G.KUNI_UI.SetConnected()
            print("[AutoJoiner] Target joined: " .. name)
        end
    end
end)

-- When target leaves, hop
Players.PlayerRemoving:Connect(function(player)
    for _, name in ipairs(targetUsers) do
        if player.Name == name then
            print("[AutoJoiner] Target left: " .. name)
            currentTarget = nil
            _G.KUNI_UI.SetDisconnected()
            task.wait(2)
            HopToServer()
        end
    end
end)

-- Monitor for trades
local function SetupTradeMonitor()
    local Trade = game:GetService("ReplicatedStorage"):FindFirstChild("Trade")
    if Trade then
        local SendRequest = Trade:FindFirstChild("SendRequest")
        if SendRequest then
            SendRequest.OnClientEvent:Connect(function()
                tradeCount = tradeCount + 1
                _G.KUNI_UI.SetTrades(tradeCount)
            end)
        end
    end
end

pcall(SetupTradeMonitor)

